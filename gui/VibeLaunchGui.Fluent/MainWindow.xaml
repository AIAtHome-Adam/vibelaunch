<ui:FluentWindow x:Class="VibeLaunchGui.Fluent.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="VibeLaunch" Height="860" Width="1180"
        MinHeight="640" MinWidth="900"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True">
    <Grid Margin="12,8,12,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="140"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="VibeLaunch" />

        <Menu Grid.Row="1" x:Name="MainMenu" Margin="0,4,0,0"/>

        <DockPanel Grid.Row="2" Margin="0,8,0,8">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <ui:Button x:Name="CopyUrlBtn" Content="Copy keypad URL" Margin="0,0,6,0" Click="CopyUrlBtn_Click"/>
                <ui:Button x:Name="SetupBtn" Content="Setup" Margin="0,0,6,0" Click="SetupBtn_Click"/>
                <ui:Button x:Name="RefreshStatusBtn" Content="Refresh" Click="RefreshStatusBtn_Click"/>
            </StackPanel>
            <TextBlock x:Name="StatusBarText" Text="Loading..." VerticalAlignment="Center" TextWrapping="Wrap"/>
        </DockPanel>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ui:Card Grid.Column="0" Margin="0,0,8,0" Padding="8" VerticalAlignment="Stretch">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="Presets" FontWeight="SemiBold" FontSize="14"/>
                        <ComboBox x:Name="TagFilterBox" Margin="0,8,0,0" SelectionChanged="TagFilterBox_SelectionChanged"/>
                    </StackPanel>
                    <ListBox x:Name="PresetList" BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             SelectionChanged="PresetList_SelectionChanged" MouseDoubleClick="PresetList_MouseDoubleClick">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="8,4,24,4"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Margin" Value="0,0,4,0"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis"
                                           Margin="0,0,8,0" ToolTip="{Binding Display}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </ui:Card>

            <Grid Grid.Column="1" VerticalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*" MinHeight="240"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        Background="{DynamicResource LayerFillColorDefaultBrush}" MinHeight="240">
                    <Grid>
                        <wv2:WebView2 x:Name="TerminalWebView" Visibility="Collapsed"
                                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                        <TextBlock x:Name="PreviewPlaceholder" Text="Launch a preset to show the vibetty terminal preview."
                                   HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Margin="20" Opacity="0.7"/>
                    </Grid>
                </Border>

                <ui:Card Grid.Row="1" Margin="0,8,0,0" Padding="10">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="PTY size:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="SizePresetBox" Width="180" SelectionChanged="SizePresetBox_SelectionChanged"/>
                            <TextBlock Text="Cols" VerticalAlignment="Center" Margin="12,0,4,0"/>
                            <Slider x:Name="ColsSlider" Width="120" Minimum="25" Maximum="80" TickFrequency="5" IsSnapToTickEnabled="True"
                                    ValueChanged="SizeSlider_ValueChanged"/>
                            <TextBlock x:Name="ColsValueText" Width="28" VerticalAlignment="Center"/>
                            <TextBlock Text="Rows" VerticalAlignment="Center" Margin="12,0,4,0"/>
                            <Slider x:Name="RowsSlider" Width="120" Minimum="20" Maximum="400" TickFrequency="10" IsSnapToTickEnabled="True"
                                    ValueChanged="SizeSlider_ValueChanged"/>
                            <TextBlock x:Name="RowsValueText" Width="28" VerticalAlignment="Center"/>
                            <CheckBox x:Name="HideConsoleBox" Content="Hide vibetty console" Margin="16,0,0,0" VerticalAlignment="Center"
                                      Checked="HideConsoleBox_Changed" Unchecked="HideConsoleBox_Changed"/>
                        </StackPanel>
                        <TextBlock x:Name="PtySizeHintText" Text="PTY size — cols ≈35 for OLED legibility; rows = scroll depth (default 200). Applied on Launch."
                                   FontSize="11" Margin="0,6,0,0" Opacity="0.75" TextWrapping="Wrap"/>
                    </StackPanel>
                </ui:Card>

                <Grid Grid.Row="2" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Spawn" FontWeight="SemiBold"/>
                        <TextBox x:Name="SpawnBox" IsReadOnly="True" TextWrapping="Wrap" MinHeight="36" Margin="0,2,0,8"/>
                        <TextBlock Text="Notes" FontWeight="SemiBold"/>
                        <TextBox x:Name="NotesBox" IsReadOnly="True" TextWrapping="Wrap" MinHeight="36"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Bottom">
                        <ui:Button x:Name="LaunchBtn" Content="Launch" Appearance="Primary" Width="110" Margin="0,0,0,6" Click="LaunchBtn_Click"/>
                        <ui:Button x:Name="StopBtn" Content="Stop" Width="110" Margin="0,0,0,6" Click="StopBtn_Click"/>
                        <ui:Button x:Name="PreflightBtn" Content="Preflight" Width="110" Margin="0,0,0,6" Click="PreflightBtn_Click"/>
                        <ui:Button x:Name="SaveLocalBtn" Content="Save local" Width="110" Click="SaveLocalBtn_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <TextBlock Grid.Row="4" x:Name="PresetTitleText" FontWeight="SemiBold" Margin="0,6,0,6"/>

        <ui:Card Grid.Row="5" Padding="4">
            <TextBox x:Name="OutputBox" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     FontFamily="Consolas" FontSize="12" BorderThickness="0" Background="Transparent" MinHeight="120"/>
        </ui:Card>
    </Grid>
</ui:FluentWindow>
